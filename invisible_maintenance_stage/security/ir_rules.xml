<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <record id="rule_maintenance_stage_visible_groups_view_column" model="ir.rule">
            <field name="name">Maintenance Stage: visible column by groups</field>
            <field name="model_id" ref="maintenance.model_maintenance_request"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|',
                    ('stage_id.group_id', '=', False),
                    ('stage_id.group_id', 'in', user.group_ids.ids)
                ]
            </field>
        </record>

        <record id="rule_maintenance_stage_visible_groups" model="ir.rule">
            <field name="name">Maintenance Stage: visible by groups</field>
            <field name="model_id" ref="maintenance.model_maintenance_stage"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|',
                    ('group_id', '=', False),
                    ('group_id', 'in', user.group_ids.ids)
                ]
            </field>
        </record>

    </data>
</odoo>
