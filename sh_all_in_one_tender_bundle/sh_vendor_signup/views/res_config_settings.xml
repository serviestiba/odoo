<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- Settings for Notifications -->
    <record id="sh_vendor_signup_res_config_settings" model="ir.ui.view">
        <field name="name">purchase setting</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='invoicing_settings_container']" position="before">
                <h2>Vendor Sign up Configuration</h2>
                <block class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-offset-6 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="is_enable_vendor_notification"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="is_enable_vendor_notification"/>
                            <p class="text-muted">Get email notification on vendor signup.</p>
                            <label for="user_ids"/>
                            <field name="user_ids" widget="many2many_tags" domain="[('share', '=', False)]"/>
                        </div>
                    </div>

                    <div class="col-12 col-lg-offset-6 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="is_enable_auto_portal_user"/>
                            <field name="is_enable_company_portal_user"/>
                            <field name="is_enable_company_contact_portal_user"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="is_enable_auto_portal_user"/>
                            <br/>
                            <label for="is_enable_company_portal_user" style="margin-top: 5px;"/>
                            <br/>
                            <label for="is_enable_company_contact_portal_user" style="margin-top: 7px;"/>
                        </div>
                    </div>

                </block>
            </xpath>

        </field>
    </record>
</odoo>
